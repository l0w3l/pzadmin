services:
    nginx-pzadmin:
        build: ./nginx
        deploy:
            resources:
                limits:
                    cpus: "0.5"
                    memory: "50m"
        logging:
            driver: json-file
            options:
                max-size: "10m"
                max-file: "3"
        ports:
            - "${APP_NGINX_HTTP:-80}:80"
            - "${APP_NGINX_HTTPS:-443}:443"
            - "${VITE_REVERB_PORT:-8080}:8080"
            - "${INERTIA_PORT:-13714}:13714"
        networks:
            - backend-pzadmin
        volumes:
            - "${STORAGE_APP}:/var/www/html"
            - "${STORAGE_NGINX}/logs/:/var/log/nginx/"
            - ./nginx/config/nginx.conf:/etc/nginx/nginx.conf:ro
            - ./nginx/config/sites-available/:/etc/nginx/sites-available/
            - ./nginx/config/sites-enabled/:/etc/nginx/sites-enabled/
            - ./nginx/config/nginxconfig.io/:/etc/nginx/nginxconfig.io/

    fpm-pzadmin:
        build:
            context: ./fpm
            args:
                HOST_UID: ${HOST_UID}
                HOST_GID: ${HOST_GID}
                DOCKER_GID: ${DOCKER_GID}

        logging:
            driver: json-file
            options:
                max-size: "10m"
                max-file: "3"
        deploy:
            resources:
                limits:
                    cpus: "0.5"
                    memory: "200m"
        networks:
            - backend-pzadmin
        volumes:
            - "${DOCKER_SOCKET}:/var/run/docker.sock"
            - "${STORAGE_APP}:/var/www/html"
            - ./fpm/config/www.conf:/usr/local/etc/php-fpm.d/www.conf

    setup-pzadmin:
        build: ./setup
        networks:
            - backend-pzadmin
        restart: no
        entrypoint: ["bash", "/usr/local/bin/scripts/setup.sh"]
        volumes:
            - "${STORAGE_APP}:/var/www/html"

    queue-pzadmin:
        build:
            context: ./queue
            args:
                HOST_UID: ${HOST_UID}
                HOST_GID: ${HOST_GID}
                DOCKER_GID: ${DOCKER_GID}
        logging:
            options:
                max-size: "10m"
                max-file: "3"
        deploy:
            resources:
                limits:
                    cpus: "0.5"
                    memory: "100m"
        networks:
            - backend-pzadmin
        restart: always
        entrypoint: [ "bash", "/usr/local/bin/scripts/laravel_queue.sh" ]
        volumes:
            - "${DOCKER_SOCKET}:/var/run/docker.sock"
            - "${STORAGE_APP}:/var/www/html"

    laravel-reverb-pzadmin:
        build: ./setup
        deploy:
            resources:
                limits:
                    cpus: "0.5"
                    memory: "100m"
        networks:
            - backend-pzadmin
        restart: "always"
        entrypoint: [ "bash", "/usr/local/bin/scripts/laravel_reverb.sh" ]
        volumes:
            - "${STORAGE_APP}:/var/www/html"

    scheduler-pzadmin:
        build:
            context: ./scheduler
            args:
                HOST_UID: ${HOST_UID}
                HOST_GID: ${HOST_GID}
                DOCKER_GID: ${DOCKER_GID}
        logging:
                    driver: json-file
                    options:
                        max-size: "10m"
                        max-file: "3"
        deploy:
            resources:
                limits:
                    cpus: "0.5"
                    memory: "100m"
        networks:
            - backend-pzadmin
        restart: always
        entrypoint: [ "bash", "/usr/local/bin/scripts/laravel_scheduler.sh" ]
        volumes:
            - "${DOCKER_SOCKET}:/var/run/docker.sock"
            - "${STORAGE_APP}:/var/www/html"

    zomboid-pzadmin:
        restart: unless-stopped
        build:
            context: ./zomboid
            args:
                ZOMBOID_BETA: ${ZOMBOID_BETA}
        env_file:
            - .env
        healthcheck:
            test:
                - CMD-SHELL
                - |
                    if [ ! -f /root/Zomboid/.server_healthy ]; then
                        if grep -q '\*\*\* SERVER STARTED \*\*\*\*' /root/Zomboid/server-console.txt; then
                            touch /root/Zomboid/.server_healthy
                        else
                            exit 1
                        fi
                    fi

                    exit 0

            interval: 3s
            retries: 1
            start_period: 10s
        networks:
            - backend-pzadmin
        ports:
            - "${ZOMBOID_PORT_1}:${ZOMBOID_PORT_1}/udp"
            - "${ZOMBOID_PORT_2}:${ZOMBOID_PORT_2}/udp"
            - "${ZOMBOID_STEAM_PORT_1}:${ZOMBOID_STEAM_PORT_1}"
            - "${ZOMBOID_STEAM_PORT_2}:${ZOMBOID_STEAM_PORT_2}"
        volumes:
            # Entry
            - ./zomboid/scripts:/server/scripts
            # Server data
            - "${STORAGE_ZOMBOID_DATA}:/root/Zomboid"
            # Workshop mods folder
            - "${STORAGE_ZOMBOID_MODS}:/pz-dedicated/steamapps/workshop"

networks:
    backend-pzadmin:
        driver: bridge
